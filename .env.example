# ==========================================
# InterviewX AI — Environment Configuration
# ==========================================

# Google Gemini API Key (Optional)
# If omitted, InterviewX AI automatically operates in Autonomous Demo Engine mode with full feature support.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Selection
# Options: gemini-2.5-flash (default, high speed & low latency) or gemini-2.5-pro (deep reasoning)
GEMINI_MODEL=gemini-2.5-flash

# Application Environment
NODE_ENV=development
